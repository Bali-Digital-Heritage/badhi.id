<style>
    .logo-small {
        width: 100px;
    }

    .hero.is-fullheight {
        position: relative;
        overflow: hidden;
    }

    .video-container {
        width: 100%;
        z-index: 0;
        overflow: hidden;
        margin-top: 2rem;
    }

    .tab-content {
        display: none;
        height: 760px;
    }

    .tab-content.is-active {
        display: block;
    }

    .tabs li {
        border-bottom: 1px solid lightgray;
    }

    .tab-list li a {
        cursor: pointer;
    }

    .tabs li.is-active a {
        font-weight: bold;
    }

    /* Accordion triggers — hidden on desktop */
    .accordion-trigger {
        display: none;
    }

    @media screen and (max-width: 768px) {
        /* Hide tab bar on mobile */
        .tabs {
            display: none !important;
        }

        /* Show accordion triggers */
        .accordion-trigger {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.9rem 1.2rem;
            margin: 0;
            background: #f5f5f5;
            border-bottom: 1px solid #ddd;
            cursor: pointer;
            user-select: none;
        }

        .accordion-trigger.is-active {
            background: #e8e8e8;
            font-weight: bold;
        }

        .accordion-trigger:first-of-type {
            border-top: 1px solid #ddd;
        }

        .accordion-icon {
            font-size: 0.75rem;
            transition: transform 0.2s ease;
        }

        .tab-content {
            height: auto;
        }

        .tab-content.is-active {
            padding: 1rem 0;
        }

        .tab-content img,
        .tab-content video {
            width: 100% !important;
            height: auto !important;
            max-width: 100%;
        }

        .hero-body {
            padding: 1.5rem 1rem;
        }

        h1.is-size-1 {
            font-size: 1.75rem !important;
        }

        h2.is-size-4 {
            font-size: 1.1rem !important;
        }
    }
</style>

<section class="hero is-fullheight" id="temple">
    <div class="hero-body info-parent">
        <div class="container">
            <h1 class="has-text-centered is-size-1 has-text-weight-semibold">Bali Digital Heritage Initiative</h1>
            <h2 class="has-text-centered is-size-4 pb-5">{{ i18n[page.lang].temple.title | safe }}</h2>

            <!-- Tabs Navigation (desktop only) -->
            <div class="tabs is-centered mt-1">
                <ul class="tabs-list">
                    <li class="is-active" data-tab="overview">
                        <a class="is-size-5">Overview</a>
                    </li>
                    <li data-tab="importance">
                        <a class="is-size-5">Importance</a>
                    </li>
                    <li data-tab="approach">
                        <a class="is-size-5">Approach</a>
                    </li>
                    <li data-tab="family">
                        <a class="is-size-5">Family Temples</a>
                    </li>
                    <li data-tab="public">
                        <a class="is-size-5">Public Temples</a>
                    </li>
                    <li data-tab="applications">
                        <a class="is-size-5">Applications</a>
                    </li>
                </ul>
            </div>
            <!-- End Tabs Navigation -->

            <!-- Overview -->
            <div class="accordion-trigger is-active" data-tab="overview">
                <span class="accordion-title is-size-5">Overview</span>
                <span class="accordion-icon">▼</span>
            </div>
            <div id="overview-content" class="tab-content has-text-centered is-active">
                <figure class="image mt-4">
                    <img class="img" src="/assets/badhi-banner-cut-min.png" alt="Temple Overview" style="width:1000px; margin:auto;"/>
                </figure>
                <div class="is-size-5 mt-5 has-text-centered">
                    <p>We aim to empower Balinese communities to preserve their cultural heritage for future generations. We believe a participatory approach — data by people for people — is the best way to achieve documentation that is scalable, sustainable and culturally safe.</p>
                </div>
            </div>
            <!-- end Overview -->

            <!-- Importance -->
            <div class="accordion-trigger" data-tab="importance">
                <span class="accordion-title is-size-5">Importance</span>
                <span class="accordion-icon">►</span>
            </div>
            <div id="importance-content" class="tab-content has-text-centered">
                {% include "../components/timeline.njk" %}
                <div class="is-size-5 mt-5 has-text-centered">
                    <p>Balinese temples have undergone cycles of destruction and reconstruction for hundreds of years. With each recreation, we have lost the authenticity of past architecture and values, and before 2024, there had been no serious effort to create records of the temples for future generations. We aim to create a record for generations over the next 50 years, 100 years and beyond.</p>
                </div>
            </div>
            <!-- end Importance -->

            <!-- Approach -->
            <div class="accordion-trigger" data-tab="approach">
                <span class="accordion-title is-size-5">Approach</span>
                <span class="accordion-icon">►</span>
            </div>
            <div id="approach-content" class="tab-content has-text-centered">
                <figure class="pt-5">
                    <img src="/assets/approach.png" alt="Our Approach" style="width:1000px; margin:auto;"/>
                </figure>
                <div class="is-size-5 mt-5 has-text-centered">
                    <p>Our approach is centred around community participation. Local communities contribute videos of temples and temple parts in their areas. We then use these videos to create high-quality 3D records of the temples. The videos, 3D models and metadata of the temples are all looped back to the communities.
                        <b>We envision the data collection campaign that runs every 5 years where, for a number of months, everyone in Bali contributes video records.</b>
                    </p>
                </div>
            </div>
            <!-- end Approach -->

            <!-- Family Temples -->
            <div class="accordion-trigger" data-tab="family">
                <span class="accordion-title is-size-5">Family Temples</span>
                <span class="accordion-icon">►</span>
            </div>
            <div id="family-content" class="tab-content has-text-centered">
                <div class="video-container is-flex is-justify-content-center is-align-items-center">
                    <video autoplay="autoplay" muted="muted" loop="loop" playsinline="playsinline" style="height:600px;">
                        <source src="/assets/Video-Sanggah.webm" type="video/webm">
                        Your browser does not support the video tag.
                    </video>
                </div>
                <div class="is-size-5 mt-5 has-text-centered">
                    <p>On our platform,
                        <b>private family temples</b>
                        can only be accessed by the owner, ensuring data privacy. This video is used with permission.</p>
                </div>
            </div>
            <!-- end Family Temples -->

            <!-- Public Temples -->
            <div class="accordion-trigger" data-tab="public">
                <span class="accordion-title is-size-5">Public Temples</span>
                <span class="accordion-icon">►</span>
            </div>
            <div id="public-content" class="tab-content has-text-centered">
                <div class="video-container is-flex is-justify-content-center is-align-items-center">
                    <video autoplay="autoplay" muted="muted" loop="loop" playsinline="playsinline" class="img" style="height:600px; margin:auto;">
                        <source src="/assets/candi-bentar.mp4" type="video/webm">
                        Your browser does not support the video tag.
                    </video>
                </div>
                <div class="is-size-5 mt-5 has-text-centered">
                    <p>Public temples can be seen and contributed to by anyone. This video shows the great gates of Pura Sari Abangan, reconstructed from community contributions. This temple was built between the 8th and 11th centuries.</p>
                </div>
            </div>
            <!-- end Public Temples -->

            <!-- Applications -->
            <div class="accordion-trigger" data-tab="applications">
                <span class="accordion-title is-size-5">Applications</span>
                <span class="accordion-icon">►</span>
            </div>
            <div id="applications-content" class="tab-content has-text-centered">
                <figure class="pt-2">
                    <img src="/assets/avp-ss.png" alt="Applications" class="img" style="width:1000px; margin:auto;"/>
                </figure>
                <div class="is-size-5 mt-5 has-text-centered">
                    <p>With the amount of collected records, the potential applications for cultural heritage preservation and education are enormous. This is an example of immersive visualisation of a temple.</p>
                </div>
            </div>
            <!-- end Applications -->

        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const tabs = document.querySelectorAll('.tabs li');
    const tabContents = document.querySelectorAll('.tab-content');
    const accordionTriggers = document.querySelectorAll('.accordion-trigger');

    function activateTab(tabName) {
        // Update tabs
        tabs.forEach(t => t.classList.remove('is-active'));
        const activeTab = document.querySelector(`.tabs li[data-tab="${tabName}"]`);
        if (activeTab) activeTab.classList.add('is-active');

        // Update accordion triggers
        accordionTriggers.forEach(a => {
            a.classList.remove('is-active');
            a.querySelector('.accordion-icon').textContent = '►';
        });
        const activeTrigger = document.querySelector(`.accordion-trigger[data-tab="${tabName}"]`);
        if (activeTrigger) {
            activeTrigger.classList.add('is-active');
            activeTrigger.querySelector('.accordion-icon').textContent = '▼';
        }

        // Update content
        tabContents.forEach(c => c.classList.remove('is-active'));
        const activeContent = document.getElementById(`${tabName}-content`);
        if (activeContent) {
            activeContent.classList.add('is-active');
            const video = activeContent.querySelector('video');
            if (video) video.play();
        }
    }

    // Desktop tabs
    tabs.forEach(tab => {
        tab.addEventListener('click', function () {
            activateTab(this.getAttribute('data-tab'));
        });
    });

    // Mobile accordion
    accordionTriggers.forEach(trigger => {
        trigger.addEventListener('click', function () {
            const tabName = this.getAttribute('data-tab');
            const isAlreadyActive = this.classList.contains('is-active');

            if (isAlreadyActive) {
                // Collapse
                this.classList.remove('is-active');
                this.querySelector('.accordion-icon').textContent = '►';
                document.getElementById(`${tabName}-content`).classList.remove('is-active');
            } else {
                activateTab(tabName);
                // Scroll into view
                this.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });
    });
});
</script>